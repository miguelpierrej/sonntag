-- Singleton para configuracoes gerais da instituicao
CREATE TABLE settings (
    id INTEGER PRIMARY KEY DEFAULT 1,
    nome TEXT NOT NULL,
    endereco TEXT,
    telefone TEXT,
    -- Sincronizacao: identidade global, carimbo de alteracao e exclusao logica
    uuid TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    updated_by TEXT NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0
);

-- Preferencias simples do app (chave/valor), ex.: idioma
CREATE TABLE app_prefs (
    chave TEXT PRIMARY KEY,
    valor TEXT NOT NULL
);

-- Configuracao de dias e horarios em que reunioes normalmente ocorrem
CREATE TABLE meeting_days (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    dia_semana INTEGER NOT NULL, -- 1=seg, 2=ter, ..., 7=dom
    hora TEXT NOT NULL, -- HH:mm
    -- Sincronizacao: identidade global, carimbo de alteracao e exclusao logica
    uuid TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    updated_by TEXT NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0
);

-- Membros da congregacao
CREATE TABLE members (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    nome TEXT NOT NULL,
    sobrenome TEXT NOT NULL,
    -- Sincronizacao: identidade global, carimbo de alteracao e exclusao logica
    uuid TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    updated_by TEXT NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0
);

-- Grupos de limpeza
CREATE TABLE cleaning_groups (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    nome TEXT NOT NULL UNIQUE,
    -- Sincronizacao: identidade global, carimbo de alteracao e exclusao logica
    uuid TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    updated_by TEXT NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0
);

-- Reunioes agendadas
CREATE TABLE meetings (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    data TEXT NOT NULL, -- yyyy-MM-dd
    hora TEXT NOT NULL, -- HH:mm
    tipo TEXT NOT NULL, -- WEEKDAY ou WEEKEND
    -- Sincronizacao: identidade global, carimbo de alteracao e exclusao logica
    uuid TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    updated_by TEXT NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0
);

-- Programacao de discursos nas reunioes de fim de semana
CREATE TABLE weekend_programs (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    meeting_id INTEGER NOT NULL UNIQUE,
    titulo_discurso TEXT,
    orador_id INTEGER,
    orador_nome TEXT,
    presidente_id INTEGER,
    dirigente_id INTEGER,
    leitor_id INTEGER,
    -- Sincronizacao: identidade global, carimbo de alteracao e exclusao logica
    uuid TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    updated_by TEXT NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (meeting_id) REFERENCES meetings(id) ON DELETE CASCADE,
    FOREIGN KEY (orador_id) REFERENCES members(id) ON DELETE SET NULL,
    FOREIGN KEY (presidente_id) REFERENCES members(id) ON DELETE SET NULL,
    FOREIGN KEY (dirigente_id) REFERENCES members(id) ON DELETE SET NULL,
    FOREIGN KEY (leitor_id) REFERENCES members(id) ON DELETE SET NULL
);

-- Programacao das reunioes de meio de semana (formulario S-140)
CREATE TABLE midweek_programs (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    meeting_id INTEGER NOT NULL UNIQUE,
    -- Cabecalho
    leitura_semanal TEXT,
    presidente_id INTEGER,
    conselheiro_id INTEGER,
    cantico_inicial TEXT,
    oracao_inicial_id INTEGER,
    -- Tesouros da Palavra de Deus
    tesouros_titulo TEXT,
    tesouros_orador_id INTEGER,
    joias_id INTEGER,
    leitura_biblia_id INTEGER,
    -- Faca seu melhor no ministerio (ate 3 partes)
    min1_titulo TEXT,
    min1_minutos TEXT,
    min1_estudante_id INTEGER,
    min1_ajudante_id INTEGER,
    min2_titulo TEXT,
    min2_minutos TEXT,
    min2_estudante_id INTEGER,
    min2_ajudante_id INTEGER,
    min3_titulo TEXT,
    min3_minutos TEXT,
    min3_estudante_id INTEGER,
    min3_ajudante_id INTEGER,
    min4_titulo TEXT,
    min4_minutos TEXT,
    min4_estudante_id INTEGER,
    min4_ajudante_id INTEGER,
    -- Nossa vida crista
    cantico_meio TEXT,
    vida1_titulo TEXT,
    vida1_minutos TEXT,
    vida1_id INTEGER,
    vida2_titulo TEXT,
    vida2_minutos TEXT,
    vida2_id INTEGER,
    estudo_dirigente_id INTEGER,
    estudo_leitor_id INTEGER,
    cantico_final TEXT,
    oracao_final_id INTEGER,
    -- Sincronizacao: identidade global, carimbo de alteracao e exclusao logica
    uuid TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    updated_by TEXT NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (meeting_id) REFERENCES meetings(id) ON DELETE CASCADE
);

-- Atribuicao de grupos de limpeza por semana
CREATE TABLE cleaning_assignments (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    semana_iso INTEGER NOT NULL,
    ano INTEGER NOT NULL,
    group_id INTEGER NOT NULL,
    -- Sincronizacao: identidade global, carimbo de alteracao e exclusao logica
    uuid TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    updated_by TEXT NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (group_id) REFERENCES cleaning_groups(id) ON DELETE CASCADE,
    UNIQUE(semana_iso, ano)
);

-- Designacoes de audio/video, plataforma, microfones e acomodadores por reuniao
CREATE TABLE av_assignments (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    meeting_id INTEGER NOT NULL UNIQUE,
    audio_id INTEGER,
    video_id INTEGER,
    plataforma1_id INTEGER,
    plataforma2_id INTEGER,
    microfone1_id INTEGER,
    microfone2_id INTEGER,
    acomodador1_id INTEGER,
    acomodador2_id INTEGER,
    -- Sincronizacao: identidade global, carimbo de alteracao e exclusao logica
    uuid TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    updated_by TEXT NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (meeting_id) REFERENCES meetings(id) ON DELETE CASCADE
);

-- Bosquejos de discursos publicos (S-34), importados de um arquivo .jwpub
CREATE TABLE talk_outlines (
    numero INTEGER PRIMARY KEY,
    titulo TEXT NOT NULL
);

-- Um uuid nunca se repete: e a identidade da linha entre maquinas
CREATE UNIQUE INDEX settings_uuid ON settings(uuid);
CREATE UNIQUE INDEX meeting_days_uuid ON meeting_days(uuid);
CREATE UNIQUE INDEX members_uuid ON members(uuid);
CREATE UNIQUE INDEX cleaning_groups_uuid ON cleaning_groups(uuid);
CREATE UNIQUE INDEX meetings_uuid ON meetings(uuid);
CREATE UNIQUE INDEX weekend_programs_uuid ON weekend_programs(uuid);
CREATE UNIQUE INDEX midweek_programs_uuid ON midweek_programs(uuid);
CREATE UNIQUE INDEX cleaning_assignments_uuid ON cleaning_assignments(uuid);
CREATE UNIQUE INDEX av_assignments_uuid ON av_assignments(uuid);

-- Conflitos detectados na fusao, aguardando decisao do usuario
CREATE TABLE sync_conflicts (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    tabela TEXT NOT NULL,
    row_uuid TEXT NOT NULL,
    local_json TEXT NOT NULL,
    remoto_json TEXT NOT NULL,
    remoto_device TEXT NOT NULL,
    detectado_em TEXT NOT NULL,
    resolvido INTEGER NOT NULL DEFAULT 0,
    UNIQUE(tabela, row_uuid)
);

-- Queries basicas

getSettings:
SELECT * FROM settings WHERE id = 1 AND deleted = 0;

insertSettings:
INSERT OR REPLACE INTO settings (id, nome, endereco, telefone, uuid, updated_at, updated_by, deleted)
VALUES (1, ?, ?, ?, ?, ?, ?, 0);

deleteSettings:
UPDATE settings SET deleted = 1, updated_at = ?, updated_by = ? WHERE id = 1;

-- App prefs queries

getPref:
SELECT valor FROM app_prefs WHERE chave = ?;

setPref:
INSERT OR REPLACE INTO app_prefs (chave, valor) VALUES (?, ?);

-- Meeting days queries

getAllMeetingDays:
SELECT * FROM meeting_days WHERE deleted = 0 ORDER BY dia_semana ASC;

getMeetingDayById:
SELECT * FROM meeting_days WHERE id = ? AND deleted = 0;

insertMeetingDay:
INSERT INTO meeting_days (dia_semana, hora, uuid, updated_at, updated_by) VALUES (?, ?, ?, ?, ?);

updateMeetingDay:
UPDATE meeting_days SET dia_semana = ?, hora = ?, updated_at = ?, updated_by = ?, deleted = 0 WHERE id = ?;

deleteMeetingDay:
UPDATE meeting_days SET deleted = 1, updated_at = ?, updated_by = ? WHERE id = ?;

deleteAllMeetingDays:
UPDATE meeting_days SET deleted = 1, updated_at = ?, updated_by = ? WHERE deleted = 0;

-- Members queries

getAllMembers:
SELECT * FROM members WHERE deleted = 0 ORDER BY nome ASC, sobrenome ASC;

getMemberById:
SELECT * FROM members WHERE id = ? AND deleted = 0;

insertMember:
INSERT INTO members (nome, sobrenome, uuid, updated_at, updated_by) VALUES (?, ?, ?, ?, ?);

updateMember:
UPDATE members SET nome = ?, sobrenome = ?, updated_at = ?, updated_by = ?, deleted = 0 WHERE id = ?;

deleteMember:
UPDATE members SET deleted = 1, updated_at = ?, updated_by = ? WHERE id = ?;

-- Cleaning groups queries

getAllCleaningGroups:
SELECT * FROM cleaning_groups WHERE deleted = 0 ORDER BY nome ASC;

getCleaningGroupById:
SELECT * FROM cleaning_groups WHERE id = ? AND deleted = 0;

-- Inclui excluidos: o UNIQUE(nome) exige reviver a linha em vez de inserir outra
getCleaningGroupByNameAny:
SELECT * FROM cleaning_groups WHERE nome = ?;

insertCleaningGroup:
INSERT INTO cleaning_groups (nome, uuid, updated_at, updated_by) VALUES (?, ?, ?, ?);

updateCleaningGroup:
UPDATE cleaning_groups SET nome = ?, updated_at = ?, updated_by = ?, deleted = 0 WHERE id = ?;

deleteCleaningGroup:
UPDATE cleaning_groups SET deleted = 1, updated_at = ?, updated_by = ? WHERE id = ?;

-- Meetings queries

getAllMeetings:
SELECT * FROM meetings WHERE deleted = 0 ORDER BY data ASC, hora ASC;

getMeetingById:
SELECT * FROM meetings WHERE id = ? AND deleted = 0;

getMeetingsByType:
SELECT * FROM meetings WHERE tipo = ? AND deleted = 0 ORDER BY data ASC, hora ASC;

insertMeeting:
INSERT INTO meetings (data, hora, tipo, uuid, updated_at, updated_by) VALUES (?, ?, ?, ?, ?, ?);

updateMeeting:
UPDATE meetings SET data = ?, hora = ?, tipo = ?, updated_at = ?, updated_by = ?, deleted = 0 WHERE id = ?;

deleteMeeting:
UPDATE meetings SET deleted = 1, updated_at = ?, updated_by = ? WHERE id = ?;

getMeetingsByDateRange:
SELECT * FROM meetings WHERE data >= ? AND data <= ? AND deleted = 0 ORDER BY data ASC, hora ASC;

getFutureMeetings:
SELECT * FROM meetings WHERE data > ? AND deleted = 0 ORDER BY data ASC, hora ASC;

getFutureMeetingsWithProgram:
SELECT meetings.*
FROM meetings
INNER JOIN weekend_programs ON weekend_programs.meeting_id = meetings.id
WHERE meetings.data > ? AND meetings.deleted = 0 AND weekend_programs.deleted = 0
ORDER BY meetings.data ASC, meetings.hora ASC;

deleteFutureMeetingsWithoutProgram:
UPDATE meetings SET deleted = 1, updated_at = ?, updated_by = ?
WHERE data > ?
  AND deleted = 0
  AND id NOT IN (
    SELECT meeting_id FROM weekend_programs WHERE deleted = 0
  );

-- Weekend programs queries

getAllWeekendPrograms:
SELECT * FROM weekend_programs WHERE deleted = 0 ORDER BY id ASC;

getWeekendProgramByMeetingId:
SELECT * FROM weekend_programs WHERE meeting_id = ? AND deleted = 0;

-- Inclui excluidos: o UNIQUE(meeting_id) exige reviver a linha em vez de inserir outra
getWeekendProgramByMeetingIdAny:
SELECT * FROM weekend_programs WHERE meeting_id = ?;

insertWeekendProgram:
INSERT INTO weekend_programs (meeting_id, titulo_discurso, orador_id, orador_nome, presidente_id, dirigente_id, leitor_id, uuid, updated_at, updated_by)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateWeekendProgram:
UPDATE weekend_programs SET titulo_discurso = ?, orador_id = ?, orador_nome = ?, presidente_id = ?, dirigente_id = ?, leitor_id = ?, updated_at = ?, updated_by = ?, deleted = 0
WHERE meeting_id = ?;

deleteWeekendProgram:
UPDATE weekend_programs SET deleted = 1, updated_at = ?, updated_by = ? WHERE meeting_id = ?;

-- Midweek programs queries

getAllMidweekPrograms:
SELECT * FROM midweek_programs WHERE deleted = 0 ORDER BY id ASC;

getMidweekProgramByMeetingId:
SELECT * FROM midweek_programs WHERE meeting_id = ? AND deleted = 0;

-- Inclui excluidos: o UNIQUE(meeting_id) exige reviver a linha em vez de inserir outra
getMidweekProgramByMeetingIdAny:
SELECT * FROM midweek_programs WHERE meeting_id = ?;

insertMidweekProgram:
INSERT INTO midweek_programs (
    meeting_id,
    leitura_semanal, presidente_id, conselheiro_id, cantico_inicial, oracao_inicial_id,
    tesouros_titulo, tesouros_orador_id, joias_id, leitura_biblia_id,
    min1_titulo, min1_minutos, min1_estudante_id, min1_ajudante_id,
    min2_titulo, min2_minutos, min2_estudante_id, min2_ajudante_id,
    min3_titulo, min3_minutos, min3_estudante_id, min3_ajudante_id,
    min4_titulo, min4_minutos, min4_estudante_id, min4_ajudante_id,
    cantico_meio,
    vida1_titulo, vida1_minutos, vida1_id,
    vida2_titulo, vida2_minutos, vida2_id,
    estudo_dirigente_id, estudo_leitor_id, cantico_final, oracao_final_id,
    uuid, updated_at, updated_by
)
VALUES (
    ?,
    ?, ?, ?, ?, ?,
    ?, ?, ?, ?,
    ?, ?, ?, ?,
    ?, ?, ?, ?,
    ?, ?, ?, ?,
    ?, ?, ?, ?,
    ?,
    ?, ?, ?,
    ?, ?, ?,
    ?, ?, ?, ?,
    ?, ?, ?
);

updateMidweekProgram:
UPDATE midweek_programs SET
    leitura_semanal = ?, presidente_id = ?, conselheiro_id = ?, cantico_inicial = ?, oracao_inicial_id = ?,
    tesouros_titulo = ?, tesouros_orador_id = ?, joias_id = ?, leitura_biblia_id = ?,
    min1_titulo = ?, min1_minutos = ?, min1_estudante_id = ?, min1_ajudante_id = ?,
    min2_titulo = ?, min2_minutos = ?, min2_estudante_id = ?, min2_ajudante_id = ?,
    min3_titulo = ?, min3_minutos = ?, min3_estudante_id = ?, min3_ajudante_id = ?,
    min4_titulo = ?, min4_minutos = ?, min4_estudante_id = ?, min4_ajudante_id = ?,
    cantico_meio = ?,
    vida1_titulo = ?, vida1_minutos = ?, vida1_id = ?,
    vida2_titulo = ?, vida2_minutos = ?, vida2_id = ?,
    estudo_dirigente_id = ?, estudo_leitor_id = ?, cantico_final = ?, oracao_final_id = ?,
    updated_at = ?, updated_by = ?, deleted = 0
WHERE meeting_id = ?;

deleteMidweekProgram:
UPDATE midweek_programs SET deleted = 1, updated_at = ?, updated_by = ? WHERE meeting_id = ?;

-- Cleaning assignments queries

getAllCleaningAssignments:
SELECT * FROM cleaning_assignments WHERE deleted = 0 ORDER BY ano ASC, semana_iso ASC;

getCleaningAssignmentByWeek:
SELECT * FROM cleaning_assignments WHERE semana_iso = ? AND ano = ? AND deleted = 0;

-- Inclui excluidos: o UNIQUE(semana_iso, ano) exige reviver a linha em vez de inserir outra
getCleaningAssignmentByWeekAny:
SELECT * FROM cleaning_assignments WHERE semana_iso = ? AND ano = ?;

getCleaningAssignmentsByYear:
SELECT * FROM cleaning_assignments WHERE ano = ? AND deleted = 0 ORDER BY semana_iso ASC;

insertCleaningAssignment:
INSERT INTO cleaning_assignments (semana_iso, ano, group_id, uuid, updated_at, updated_by) VALUES (?, ?, ?, ?, ?, ?);

updateCleaningAssignment:
UPDATE cleaning_assignments SET group_id = ?, updated_at = ?, updated_by = ?, deleted = 0 WHERE semana_iso = ? AND ano = ?;

deleteCleaningAssignmentByWeek:
UPDATE cleaning_assignments SET deleted = 1, updated_at = ?, updated_by = ? WHERE semana_iso = ? AND ano = ?;

-- Talk outlines queries (S-34)

getAllTalkOutlines:
SELECT * FROM talk_outlines ORDER BY numero ASC;

insertTalkOutline:
INSERT OR REPLACE INTO talk_outlines (numero, titulo) VALUES (?, ?);

deleteAllTalkOutlines:
DELETE FROM talk_outlines;

-- AV assignments queries

getAllAvAssignments:
SELECT * FROM av_assignments WHERE deleted = 0 ORDER BY id ASC;

getAvAssignmentByMeetingId:
SELECT * FROM av_assignments WHERE meeting_id = ? AND deleted = 0;

-- Inclui excluidos: o UNIQUE(meeting_id) exige reviver a linha em vez de inserir outra
getAvAssignmentByMeetingIdAny:
SELECT * FROM av_assignments WHERE meeting_id = ?;

insertAvAssignment:
INSERT INTO av_assignments (
    meeting_id,
    audio_id, video_id,
    plataforma1_id, plataforma2_id,
    microfone1_id, microfone2_id,
    acomodador1_id, acomodador2_id,
    uuid, updated_at, updated_by
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateAvAssignment:
UPDATE av_assignments SET
    audio_id = ?, video_id = ?,
    plataforma1_id = ?, plataforma2_id = ?,
    microfone1_id = ?, microfone2_id = ?,
    acomodador1_id = ?, acomodador2_id = ?,
    updated_at = ?, updated_by = ?, deleted = 0
WHERE meeting_id = ?;

deleteAvAssignment:
UPDATE av_assignments SET deleted = 1, updated_at = ?, updated_by = ? WHERE meeting_id = ?;


